# Re-Entry Predictor
# Estimate the landing distance (downrange) from the Kármán line (100 km altitude)

import numpy as np
import matplotlib.pyplot as plt
from datetime import timedelta, datetime
import time
import os

# =================================================================
# 1. PHYSICAL CONSTANTS
# =================================================================
R_EARTH, G_ACCEL, RHO_0, H_SCALE = 6371000.0, 9.81, 1.225, 8500.0
KARMAN_LINE, K_SG, ROT_SPEED = 100000.0, 1.7415e-4, 7.2921e-5 

# =================================================================
# 2. USER CONFIGURATION PANEL
# =================================================================
MISSION_NAME = "Phoenix_Ultra_Unified"

PAYLOAD_MASS_KG = 24.0
START_ALT_KM, START_VEL_MPS = 300.0, 7650.0
ENTRY_ANGLE_DEG = 3.75               # User Target Angle
TARGET_LAT, TARGET_LON = 28.47, -80.57

TPS_DENSITY, TPS_THICKNESS = 480.0, 0.05
CHUTE_CD, SHIELD_CD = 1.8, 1.5
CHUTE_DEPLOY_ALT_M, AVG_WIND_SPEED_MPS = 5000.0, 8.0
SHOCK_FACTOR_X = 1.6                 # Parachute inflation multiplier

# Study Ranges
TEST_SHIELD_DIAMS = [0.8, 1.2, 1.8]  
TEST_CHUTE_DIAMS = [3.0, 5.0]   

# =================================================================
# 3. CORE ENGINE (MEMORY SAFE & HIGH PRECISION)
# =================================================================
def run_master_sim(s_dia, p_dia, gamma_in):
    s_area = np.pi * (s_dia / 2)**2
    shield_mass = s_area * TPS_THICKNESS * TPS_DENSITY
    total_mass = PAYLOAD_MASS_KG + shield_mass + 5.0
    beta = total_mass / (SHIELD_CD * s_area)
    
    h, gamma = START_ALT_KM * 1000.0, np.radians(gamma_in)
    vx, vz = START_VEL_MPS * np.cos(gamma), START_VEL_MPS * np.sin(gamma)
    
    t, t_k, t_c, max_g, max_q, shock_g, k_reached = 0, 0, 0, 0, 0, 0, False
    alt_log, g_log, q_log = [], [], []
    lon_rel, step_count = 0.0, 0

    while h > 0:
        # Variable Time-Step (Fast in space, precise in air)
        dt = 0.05 if h < (KARMAN_LINE + 5000) else 2.0 
        rho = RHO_0 * np.exp(-h / H_SCALE) if h < KARMAN_LINE else 1e-15
        v_mag = np.sqrt(vx**2 + vz**2)
        
        if h <= KARMAN_LINE and not k_reached: t_k, k_reached = t, True
        
        # Aero Phase & Shock Capture
        if h <= CHUTE_DEPLOY_ALT_M:
            p_area = np.pi * (p_dia / 2)**2
            if shock_g == 0:
                q_dyn = 0.5 * rho * v_mag**2
                shock_g = (q_dyn * p_area * CHUTE_CD * SHOCK_FACTOR_X) / (total_mass * G_ACCEL)
            area, cd = p_area, CHUTE_CD
            t_chute = t_c; t_c += dt
        else:
            area, cd = s_area, SHIELD_CD

        drag_a = (0.5 * rho * v_mag**2 * cd * area) / total_mass
        vx += (-(drag_a * (vx / v_mag))) * dt
        vz += (-(drag_a * (vz / v_mag)) + G_ACCEL) * dt
        h -= vz * dt 
        
        cur_g = drag_a / G_ACCEL
        max_g = max(max_g, cur_g)
        
        q_dot = 0
        if h < KARMAN_LINE:
            q_dot = (K_SG * np.sqrt(rho / (s_dia/2)) * (v_mag**3)) / 10000.0
            max_q = max(max_q, q_dot)
        
        # MEMORY SAFE LOGGING (Downsample 1:20)
        if step_count % 20 == 0:
            alt_log.append(h/1000); g_log.append(cur_g); q_log.append(q_dot)
        
        t += dt; step_count += 1
        lon_rel += (vx * dt) / (R_EARTH * np.cos(np.radians(TARGET_LAT)))
        if v_mag < 0.2: break

    return {"lon": np.degrees(lon_rel) - np.degrees(ROT_SPEED * t), "beta": beta,
            "t1": t_k, "t2": t - t_k, "g": max_g, "q": max_q, "shock": shock_g,
            "alt": alt_log, "g_arr": g_log, "q_arr": q_log}

# =================================================================
# 4. EXECUTION & OUTPUT
# =================================================================
output_lines = []
def log_p(text): print(text); output_lines.append(text)

log_p(f"{'='*130}\nMISSION MASTER: {MISSION_NAME} | Entry Angle: {ENTRY_ANGLE_DEG}°\n{'='*130}")

# Solving Targeting Burn
e_lon = TARGET_LON - 22.0
for _ in range(5):
    s = run_master_sim(TEST_SHIELD_DIAMS[1], TEST_CHUTE_DIAMS[0], ENTRY_ANGLE_DEG)
    e_lon += (TARGET_LON - (e_lon + s['lon']))
log_p(f"DEORBIT BURN: Lat {TARGET_LAT}, Long {e_lon:.4f}\n")

header = f"{'Shield(m)':<10} | {'Chute(m)':<10} | {'Beta':<8} | {'P1 Time':<10} | {'P2 Time':<10} | {'Max G':<8} | {'Shock G':<8} | {'Heat':<8} | {'Status'}"
log_p(header); log_p("-" * 130)

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))

for sd in TEST_SHIELD_DIAMS:
    for pd in TEST_CHUTE_DIAMS:
        r = run_master_sim(sd, pd, ENTRY_ANGLE_DEG)
        surv = "PASS" if (r['g'] <= 12.0 and r['shock'] <= 12.0) else "FAIL"
        
        row = f"{sd:<10.1f} | {pd:<10.1f} | {r['beta']:<8.1f} | {str(timedelta(seconds=int(r['t1']))):<10} | {str(timedelta(seconds=int(r['t2']))):<10} | {r['g']:<8.1f} | {r['shock']:<8.1f} | {r['q']:<8.1f} | {surv}"
        log_p(row)
        
        if pd == TEST_CHUTE_DIAMS[0]:
            ax1.plot(r['g_arr'], r['alt'], label=f"S:{sd}m")
            ax2.plot(r['q_arr'], r['alt'], label=f"S:{sd}m")
        # Clear specific loop data for RAM
        r['alt'] = r['g_arr'] = r['q_arr'] = None

# Auto-Angle Solver
log_p(f"\n{'-'*35} AUTO-ANGLE SOLVER (Target: 11.9G Limit) {'-'*35}")
lo, hi = 0.5, 10.0
for _ in range(12):
    mid = (lo + hi) / 2
    res = run_master_sim(TEST_SHIELD_DIAMS[1], TEST_CHUTE_DIAMS[0], mid)
    if res['g'] < 11.9: lo = mid
    else: hi = mid
log_p(f"STEEPEST SURVIVABLE ANGLE: {mid:.3f}°")

# Recommendations
log_p(f"\n{'='*40} ENGINEER'S RECOMMENDATIONS {'='*40}")
if r['g'] > 12:
    log_p(f"- CRITICAL: G-Load of {r['g']:.1f} exceeds structural limits.")
    log_p(f"- ACTION: Shallow ENTRY_ANGLE_DEG to ~{mid:.2f}° or increase shield size.")
if r['shock'] > 12:
    log_p(f"- DANGER: Parachute opening shock ({r['shock']:.1f}G) will snap shroud lines.")
    log_p("- ACTION: Increase deployment altitude or use a smaller main chute.")

# Plot Formatting
ax1.set_title("Deceleration Profile"); ax1.set_xlabel("Gs"); ax1.set_ylabel("Alt (km)"); ax1.grid(True); ax1.legend()
ax2.set_title("Thermal Flux Profile"); ax2.set_xlabel("W/cm²"); ax2.set_ylabel("Alt (km)"); ax2.grid(True); ax2.legend()
plt.tight_layout(); plt.show()
